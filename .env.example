DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/cat-collector

# Use a random string with at least 32 characters. For example, run `openssl rand -hex 32`.
SESSION_SECRET=

# List the allowed browser origins. Use a comma between each origin.
CORS_ORIGINS=http://localhost:3000

NODE_ENV=development
PORT=4000
SESSION_TTL_DAYS=7

# Build indexes when the server starts. Keep this value false in development because autoIndex builds the indexes.
SYNC_INDEXES=false
