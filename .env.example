DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/cat-collector

# Any random string of at least 32 characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

NODE_ENV=development
PORT=4000
SESSION_TTL_DAYS=7

# Build indexes at boot. Leave off in development, where autoIndex handles it.
SYNC_INDEXES=false
